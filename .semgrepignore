# Semgrep ignore file - files/directories to exclude from scanning
# https://semgrep.dev/docs/ignoring-files-folders-code/

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
build/
.next/
out/

# Testing
coverage/
.nyc_output/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Environment files (already protected by other secret scanners)
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Temporary files
*.tmp
.DS_Store

# Git
.git/

# Documentation (not executable code)
*.md
docs/**/*.md

# Generated files
**/generated/**
**/__generated__/**

# Vendored third-party code
vendor/
third_party/

