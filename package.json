{
  "name": "dental-crm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "NEXT_DISABLE_SWC_WASM=1 next build",
    "start": "next start -p ${PORT:-3000}",
    "db:validate": "supabase db lint",
    "db:migrate": "supabase db push",
    "smoke": "bash scripts/smoke.sh",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:marketing-audit": "jest src/lib/marketing-audit --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:visual": "playwright test tests/visual",
    "test:performance": "playwright test tests/performance",
    "test:accessibility": "playwright test tests/accessibility",
    "test:load": "artillery run artillery.yml",
    "test:unit": "jest --testPathPattern=\\.test\\.ts$",
    "test:integration": "jest --testPathPattern=\\.integration\\.test\\.ts$",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "lint:marketing-audit": "eslint src/lib/marketing-audit src/components/marketing-audit",
    "type-check": "tsc --noEmit",
    "analyze": "ANALYZE=true next build",
    "lighthouse": "lhci autorun",
    "lighthouse:all": "./scripts/lighthouse-all-pages.sh",
    "check:security": "npm audit && npm run lint",
    "check:vitals": "lighthouse http://localhost:3000/marketing-audit --only-categories=performance",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "demo:seed": "ts-node scripts/demo/seed.ts",
    "demo:clear": "ts-node scripts/demo/clear.ts",
    "demo:reset": "npm run demo:clear && npm run demo:seed",
    "seed:deepak": "tsx scripts/demo/seed-deepak.ts",
    "clear:deepak": "tsx scripts/demo/clear-deepak.ts",
    "reset:deepak": "npm run clear:deepak && npm run seed:deepak",
    "verify:deepak": "tsx scripts/demo/verify-deepak.ts",
    "screens:seed": "tsx tools/seed.ts",
    "screens:manifest": "tsx tools/build-screens-manifest.ts",
    "screens:run": "tsx tools/screenshot-all.ts",
    "screens:all": "npm run screens:seed && npm run screens:manifest && npm run screens:run",
    "diagram:build": "mmdc -i docs/architecture.mmd -o 'CRM screenshots/architecture.png' && mmdc -i docs/deployment.mmd -o 'CRM screenshots/deployment.png'",
    "investor:pack": "npm run screens:all && npm run diagram:build && tsx tools/stack-cost-export.ts && tsx tools/feature-matrix.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@json2csv/plainjs": "^7.0.6",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sendgrid/mail": "^8.1.6",
    "@stripe/react-stripe-js": "^5.2.0",
    "@stripe/stripe-js": "^8.1.0",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.39.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.8.6",
    "chart.js": "^4.4.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.0.6",
    "email-validator": "^2.0.4",
    "framer-motion": "^11.18.2",
    "googleapis": "^140.0.1",
    "grapesjs": "^0.22.13",
    "grapesjs-preset-newsletter": "^1.0.2",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.4.1",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "libphonenumber-js": "^1.12.24",
    "lucide-react": "^0.309.0",
    "next": "15.5.4",
    "openai": "^6.3.0",
    "papaparse": "^5.5.3",
    "pino": "^10.0.0",
    "react": "19.1.0",
    "react-chartjs-2": "^5.2.0",
    "react-csv": "^2.2.2",
    "react-dom": "19.1.0",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-hook-form": "^7.65.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^3.2.1",
    "resend": "^3.2.0",
    "signature_pad": "^5.1.1",
    "sonner": "^2.0.7",
    "stripe": "^19.1.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "twilio": "^5.10.3",
    "web-vitals": "^3.5.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.3",
    "@lhci/cli": "^0.15.1",
    "@mermaid-js/mermaid-cli": "^10.6.1",
    "@playwright/test": "^1.40.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/google.analytics": "^0.0.45",
    "@types/jest": "^29.5.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "artillery": "^2.0.3",
    "autoprefixer": "^10.4.16",
    "axe-playwright": "^2.0.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.4",
    "glob": "^10.3.10",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8",
    "prettier": "^3.1.1",
    "tailwindcss": "^4.0.0-beta.19",
    "tsx": "^4.7.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
