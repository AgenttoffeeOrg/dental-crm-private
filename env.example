# Existing environment variables...
# (Keep all your existing variables)

# ============================================
# MARKETING AUDIT MODULE - FEATURE FLAGS
# ============================================
NEXT_PUBLIC_ENABLE_MARKETING_AUDIT=false
MARKETING_AUDIT_PHASE=1  # 1|2|3

# ============================================
# GOOGLE APIS (for Marketing Audit Phase 1)
# ============================================
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_OAUTH_CLIENT_ID=your_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret_here

# ============================================
# BRIGHTLOCAL API (for Marketing Audit Phase 2)
# ============================================
BRIGHTLOCAL_API_KEY=your_brightlocal_api_key_here
BRIGHTLOCAL_USER_ID=your_brightlocal_user_id_here

# ============================================
# SEMRUSH API (for Marketing Audit Phase 3)
# ============================================
SEMRUSH_API_KEY=your_semrush_api_key_here

# ============================================
# REDIS (for Rate Limiting)
# ============================================
REDIS_URL=redis://localhost:6379
