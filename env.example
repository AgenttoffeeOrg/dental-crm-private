# Existing environment variables...
# (Keep all your existing variables)

# ============================================
# MARKETING AUDIT MODULE - FEATURE FLAGS
# ============================================
NEXT_PUBLIC_ENABLE_MARKETING_AUDIT=false
MARKETING_AUDIT_PHASE=1  # 1|2|3

# ============================================
# GOOGLE APIS (for Marketing Audit Phase 1)
# ============================================
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_OAUTH_CLIENT_ID=your_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret_here

# ============================================
# BRIGHTLOCAL API (for Marketing Audit Phase 2)
# ============================================
BRIGHTLOCAL_API_KEY=your_brightlocal_api_key_here
BRIGHTLOCAL_USER_ID=your_brightlocal_user_id_here

# ============================================
# SEMRUSH API (for Marketing Audit Phase 3)
# ============================================
SEMRUSH_API_KEY=your_semrush_api_key_here

# ============================================
# REDIS (for Rate Limiting)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# MULTI-LOCATION & BILLING FEATURE FLAGS
# ============================================
# Domain discovery to prevent duplicate organizations
NEXT_PUBLIC_ENABLE_DOMAIN_DISCOVERY=true

# Join request system for employees
NEXT_PUBLIC_ENABLE_JOIN_REQUESTS=true

# Multi-location support for dental groups
NEXT_PUBLIC_ENABLE_MULTI_LOCATION=false

# Seat limit enforcement
ENABLE_SEAT_ENFORCEMENT=true

# Subdomain routing (requires DNS configuration)
NEXT_PUBLIC_ENABLE_SUBDOMAIN_ROUTING=false

# Billing integration
ENABLE_BILLING=false

# Email sending (vs console logging)
ENABLE_EMAIL_SENDING=false

# ============================================
# EMAIL PROVIDER CONFIGURATION
# ============================================
# Email provider: resend | sendgrid | console
EMAIL_PROVIDER=console

# Resend API (if using Resend)
RESEND_API_KEY=re_your_api_key_here

# SendGrid API (if using SendGrid)
SENDGRID_API_KEY=SG.your_api_key_here

# Email addresses
EMAIL_FROM=Dental CRM <noreply@dentalcrm.com>
SUPPORT_EMAIL=support@dentalcrm.com
NO_REPLY_EMAIL=noreply@dentalcrm.com
EMAIL_REPLY_TO=support@dentalcrm.com

# ============================================
# STRIPE BILLING CONFIGURATION
# ============================================
# Stripe API keys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe webhook secret (for webhook signature verification)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Public app URL (for email links, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# App environment
NODE_ENV=development

# ============================================
# DEMO MODE CONFIGURATION
# ============================================
# Full demo/sandbox environment with tenant isolation
DEMO_MODE=false
DEMO_TENANT_ID=demo-tenant
DEMO_RESET_TOKEN=generate_random_string_here
DEMO_SAFE_EMAIL_DOMAIN=demo.example.com
DEMO_FEATURES_ALL_ENABLED=true
DEMO_MINIMAL=true

# ============================================
# INTEGRATION CREDENTIAL MANAGEMENT
# ============================================
# Encryption key used by backend when calling integration_store_credentials/load
INTEGRATION_CREDENTIAL_KEY=Agenttoffee!1406milo

# Twilio (local defaults for testing)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_SENDER=
TWILIO_VOICE_CALLER_ID=

# SendGrid (override EMAIL_PROVIDER=sendgrid when enabled)
DEFAULT_FROM_EMAIL=
DEFAULT_REPLY_TO_EMAIL=
